# 每台机器复制为 node.env；只改“节点身份”一节。文件中不放密码。

# ---- 节点身份：10.8.8.66 示例 ----
NODE_ID=A
LOCAL_IP=10.8.8.66
PEER_IP=10.8.8.67
VIP=10.8.8.65
INTERFACE=eno2
VRRP_PRIORITY=150
PEER_PRIORITY=100
VRRP_VIRTUAL_ROUTER_ID=137
VRRP_ROUTER_ID=IOTDB_HA_A

# ---- HA 控制 ----
IOTDB_RPC_PORT=6667
HA_STATUS_PORT=16668
FENCE_LEASE_SECONDS=10
CONTROLLER_INTERVAL_SECONDS=1
CONTROLLER_PROGRESS_MAX_AGE_SECONDS=5
LEASE_HEARTBEAT_MAX_AGE_SECONDS=6
MASTER_PENDING_GRACE_SECONDS=6
PIPE_CHECK_INTERVAL_SECONDS=15
STANDBY_PIPE_AUDIT_INTERVAL_SECONDS=300
PEER_STATUS_TIMEOUT_SECONDS=2
PIPE_BASE_NAME=ha_a_to_b
PIPE_PROXY_SUBNET=172.31.255.0/29
PIPE_PROXY_HOST=172.31.255.2
PIPE_PROXY_PORT=16667
PIPE_PROXY_LEASE_SECONDS=6
PIPE_PROXY_HEARTBEAT_MAX_AGE_SECONDS=4
PIPE_STALL_SECONDS=60
PIPE_NOT_RUNNING_CONFIRMATIONS=3
PIPE_REPAIR_BACKOFF_MAX_SECONDS=300
PIPE_PROGRESS_MIN_BYTES=1048576
PIPE_QOS_RATE_MBIT=180
PIPE_QOS_BURST=1mb
PIPE_QOS_LATENCY_MS=100
PIPE_BATCH_DELAY_MS=200
PIPE_BATCH_SIZE_BYTES=1048576
PIPE_PARALLEL_TASKS=2
PIPE_RATE_LIMIT_BYTES_PER_SECOND=20971520
PIPE_COMPRESSOR=lz4
IOTDB_SQL_TIMEOUT_SECONDS=10
TCP_HEALTH_MAX_AGE_SECONDS=5
SQL_HEALTH_MAX_AGE_SECONDS=35
CONTAINER_TCP_HEALTH_MAX_AGE_SECONDS=10
CONTAINER_SQL_HEALTH_MAX_AGE_SECONDS=45
IOTDB_ADMIN_PASSWORD_FILE=/run/secrets/iotdb_admin_password
VRRP_AUTH_FILE=/run/secrets/vrrp_auth_pass

# ---- IoTDB JVM ----
# 这是 IoTDB 1.3.7 启动脚本真正读取的总内存预算；HA 入口会分别写入
# datanode-env.sh / confignode-env.sh。18G + 2G 给容器自身仍留约 4G 余量。
DATANODE_MEMORY_SIZE=18G
CONFIGNODE_MEMORY_SIZE=2G

# ---- IoTDB 1.3.7 standalone ----
dn_rpc_address=0.0.0.0
dn_rpc_port=6667
dn_internal_address=127.0.0.1
timestamp_precision=ms
enable_auto_create_schema=true

# 32 逻辑核、机械盘、与业务服务同机的保守起点。
data_region_per_data_node=8
flush_thread_count=8
compaction_thread_count=8
max_number_of_points_in_page=10000
wal_mode=ASYNC
datanode_memory_proportion=3:2:4:1:1:1
schema_memory_proportion=6:3:1

# 1.3.7 普通 Pipe 只按封闭 TsFile 发送。把空闲写同步上界压到约 2 秒；
# 高负载投产前必须结合小文件数量与 compaction 压测复核。
enable_timed_flush_seq_memtable=true
seq_memtable_flush_interval_in_ms=1000
seq_memtable_flush_check_interval_in_ms=1000
enable_timed_flush_unseq_memtable=true
unseq_memtable_flush_interval_in_ms=1000
unseq_memtable_flush_check_interval_in_ms=1000

# Pipe 线程与连接数：单方向运行，另一方向严格 STOP + 网络隔离。
# 总出口再做服务端二次限速，20 MiB/s 约占 1Gbps 链路的 16.8%。
# IoTDB 1.3.7 源码的真实硬下限分别是 5/4/32/16；活跃发送并发
# 仍由上面的 sink.parallel.tasks=2 控制。
pipe_subtask_executor_max_thread_num=5
pipe_sink_selector_number=4
pipe_sink_max_client_number=32
pipe_sink_max_tsfile_client_number=16
pipe_sink_timeout_ms=60000
pipe_all_sinks_rate_limit_bytes_per_second=20971520
pipe_send_tsfile_rate_limit_bytes_per_second=20971520
pipe_sink_read_file_buffer_size=1048576
