# ThingsBoard + IoTDB 1.3.7 standalone production baseline.
# Copy the required values into the ThingsBoard deployment .env; do not store real passwords here.

DATABASE_TS_TYPE=iotdb
DATABASE_TS_LATEST_TYPE=iotdb
TB_EDQS_SYNC_ENABLED=false
TB_EDQS_API_SUPPORTED=false

IOTDB_NODE_URLS=iotdb:6667
IOTDB_USER=root
IOTDB_PASSWORD=CHANGE_ME
IOTDB_DATABASE=root.tb

# 365 days. Fail startup if the database TTL cannot be applied.
IOTDB_TTL_MS=31536000000
IOTDB_TTL_FAIL_FAST=true

# PCS/BMS 200-350 key latest requests stay within one SELECT LAST RPC.
IOTDB_LATEST_BATCH_SIZE=500
IOTDB_READ_QUEUE_CAPACITY=0
IOTDB_READ_SLOW_QUERY_MS=1000

# One-second visibility target; keep unlimited backpressure wait so recoverable data stays in Kafka.
IOTDB_WRITE_FLUSH_INTERVAL_MS=1000
IOTDB_WRITE_MAX_BACKPRESSURE_WAIT_MS=0
IOTDB_WRITE_STATS_INTERVAL_MS=10000

# Bound stalled RPCs so pending writes and Kafka offsets can recover after IoTDB faults.
IOTDB_CONNECTION_TIMEOUT_MS=15000
IOTDB_SESSION_WAIT_TIMEOUT_MS=10000
IOTDB_MAX_RETRY_COUNT=3
IOTDB_RETRY_INTERVAL_MS=1000
IOTDB_QUERY_TIMEOUT_MS=60000
